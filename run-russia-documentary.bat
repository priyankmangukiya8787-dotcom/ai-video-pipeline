@echo off
setlocal
cd /d "%~dp0"

if not exist "russia-history-documentary.md" (
  echo [ERROR] russia-history-documentary.md not found in this project folder.
  pause
  exit /b 1
)

if not exist ".env" (
  echo [ERROR] .env file missing. Copy .env.example to .env and configure your API keys.
  pause
  exit /b 1
)

if not exist ".venv\Scripts\python.exe" (
  echo [ERROR] Python virtual environment missing. Follow docs/SETUP.md first.
  pause
  exit /b 1
)

echo.
echo ==========================================================
echo  RUSSIA HISTORY DOCUMENTARY - GENERATE AND RENDER
echo  This script does NOT upload anything to YouTube.
echo ==========================================================
echo.

echo [1/3] Generating narration, audio, images, and storyboards...
node produce-video.js "russia-history-documentary.md" --shorts
if errorlevel 1 (
  echo [ERROR] Content generation failed. Check the message above.
  pause
  exit /b 1
)

echo.
echo [2/3] Rendering main video and Shorts...
cd my-video
call npm run build:all
if errorlevel 1 (
  cd ..
  echo [ERROR] Remotion rendering failed.
  pause
  exit /b 1
)
cd ..

echo.
echo [3/3] Done. Check these files:
echo   my-video\out\video.mp4
echo   my-video\out\shorts.mp4
echo   my-video\out\thumbnail.jpg (if generated by configured provider)
echo.
echo Nothing was uploaded to YouTube.
pause
